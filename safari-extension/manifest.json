{
  "manifest_version": 3,
  "name": "Hub Trade",
  "short_name": "Hub Trade",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "author": "Summit Office Solution",
  "description": "Quick access to your Hub Trade dashboard, jobs, time cards and data-entry help — plus one-tap job notes from any page.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Hub Trade",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://trade-hub-910.emergent.host/*",
    "https://trade-hub-910.preview.emergentagent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://trade-hub-910.emergent.host/*",
        "https://trade-hub-910.preview.emergentagent.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://trade-hub-910.emergent.host/*",
        "https://trade-hub-910.preview.emergentagent.com/*"
      ]
    }
  ]
}
